# Storefront under test. Use the unpublished/staging theme preview whenever possible.
BASE_URL=https://www.daosense.org

# Optional: id of an unpublished theme to preview (shopify theme list). Leave empty to test the published theme.
PREVIEW_THEME_ID=

# Optional: storefront password (only if the store/preview is password protected).
STOREFRONT_PASSWORD=

# Set to true only when Header → "Show market popup" is enabled on the theme under test.
MARKET_POPUP_ENABLED=false

# Set to true to run the MKT-019 catalogue crawl (~100+ requests). Run it on its own — it can trip the store's rate limit.
RUN_DATA_CHECK=false

# E-mail of the test member (customer tagged active_subscription) — used to check the profile in the members area.
# Log in once with `npm run auth:member`; the session is saved to .auth/member.json.
MEMBER_EMAIL=

# Pause after each test, ms (the live store rate-limits bursts with HTTP 429). 0 = no pause.
TEST_PAUSE_MS=3000

# Set to true to let CART-006 open the Shopify checkout on 4 markets (it never pays).
RUN_CHECKOUT=false

# A valid discount code for CART-003. Without it only the "unknown code" path is checked.
PROMO_CODE=
